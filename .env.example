APP_NAME="Happy Pratheep Recharge"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Colombo

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- SQLite (default, zero-config) ---
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# --- Uncomment the block below to use MySQL instead ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pratheep_recharge
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@happypratheep.lk"
MAIL_FROM_NAME="${APP_NAME}"
